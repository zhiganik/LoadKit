<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>loadtest</AssemblyName>
    <RootNamespace>LoadKit.Cli</RootNamespace>
  </PropertyGroup>

  <!-- dotnet tool: dotnet tool install -g LoadKit → command `loadtest`. -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>loadtest</ToolCommandName>
    <PackageId>LoadKit</PackageId>
    <Title>LoadKit</Title>
    <Description>Local HTTP load testing from a JSON scenario: p50/p95/p99, errors by status code, Markdown/JSON reports, threshold exit codes, token auth (bearer, API key, login, OAuth2, Entra ID), and a skill for AI assistants.</Description>
    <PackageTags>load-testing;performance;http;percentiles;cli;dotnet-tool;ai-skill</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <!-- Run on newer .NET runtimes too when .NET 10 is not installed. -->
    <RollForward>Major</RollForward>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LoadKit.Core\LoadKit.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Spectre.Console.Cli" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="LoadKit.IntegrationTests" />
  </ItemGroup>

  <!--
    Embedded by link, no copies in the repository (ADR-003):
    - the scenario schema, written by init to loadtests/scenario.schema.json;
    - the user-facing skill, written by ai install. Resource names keep the relative path: LoadKit.AiAssets/loadtest/<path>.
  -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\schemas\scenario.schema.json" Link="Assets\scenario.schema.json" LogicalName="LoadKit.Assets.scenario.schema.json" />
    <EmbeddedResource Include="..\..\ai\skills\loadtest\**\*" LinkBase="AiAssets\loadtest" LogicalName="LoadKit.AiAssets/loadtest/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
